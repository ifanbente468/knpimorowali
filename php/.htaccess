DirectoryIndex index.php
Options -Indexes

<Files "config.php">
  Require all denied
</Files>
<Files "config.sample.php">
  Require all denied
</Files>
<Files "lib.php">
  Require all denied
</Files>
<Files "theme.php">
  Require all denied
</Files>

RewriteEngine On
RewriteRule ^berita/?$ berita.php [L,QSA]
RewriteRule ^berita/([A-Za-z0-9-]+)/?$ berita.php?slug=$1 [L,QSA]
RewriteRule ^agenda/?$ agenda.php [L,QSA]
RewriteRule ^agenda/([A-Za-z0-9-]+)/?$ agenda.php?slug=$1 [L,QSA]
RewriteRule ^galeri/?$ galeri.php [L,QSA]
RewriteRule ^organisasi/?$ organisasi.php [L,QSA]
RewriteRule ^profil/?$ profil.php [L,QSA]
