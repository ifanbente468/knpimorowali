DirectoryIndex index.php
Options -Indexes

<Files "config.php">
  Require all denied
</Files>
<Files "config.sample.php">
  Require all denied
</Files>
<Files "lib.php">
  Require all denied
</Files>
<Files "theme.php">
  Require all denied
</Files>
<Files "CARA-UPLOAD.txt">
  Require all denied
</Files>
<FilesMatch "^(error_log|\.php-sessions)$">
  Require all denied
</FilesMatch>

RewriteEngine On
RewriteRule ^berita/?$ berita.php [L,QSA]
RewriteRule ^berita/([A-Za-z0-9-]+)/?$ berita.php?slug=$1 [L,QSA]
RewriteRule ^agenda/?$ agenda.php [L,QSA]
RewriteRule ^agenda/([A-Za-z0-9-]+)/?$ agenda.php?slug=$1 [L,QSA]
RewriteRule ^galeri/?$ galeri.php [L,QSA]
RewriteRule ^organisasi/?$ organisasi.php [L,QSA]
RewriteRule ^profil/?$ profil.php [L,QSA]
RewriteRule ^aspirasi/?$ aspirasi.php [L,QSA]
RewriteRule ^aspirasi/lacak/?$ lacak.php [L,QSA]
RewriteRule ^anggota/daftar/?$ anggota/daftar.php [L,QSA]
RewriteRule ^anggota/cek/?$ anggota/cek.php [L,QSA]
